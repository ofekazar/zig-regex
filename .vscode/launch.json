{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Zig with Visual Studio Debugger",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/zig-out/bin/zig_regex.exe",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "preLaunchTask": "zig build"
        }
    ]
}